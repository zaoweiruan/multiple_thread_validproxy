// resources/WebDavSecret.cpp.in
// Embedded WebDAV credential blob. `@WEBDAV_SECRET_BLOB@` is substituted at
// configure time from resources/webdav_secret.inc (gitignored). When that file
// is absent the blob is empty and cloud sync reports "credentials not configured".
//
// SECURITY: obfuscation only - the key ships in the same binary.
#include <string>

namespace net {

extern const char* const kWebDavSecretBlob =
        R"WDAVBLOB(@WEBDAV_SECRET_BLOB@)WDAVBLOB";

} // namespace net
